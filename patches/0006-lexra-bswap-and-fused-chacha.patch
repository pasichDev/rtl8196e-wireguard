+/*
+ * labgw: one pass per 64-byte block. The permuted words are fed forward and
+ * XORed straight into the destination, one byte swap per word, instead of a
+ * stack keystream, per-block zeroing and a separate crypto_xor_cpy() pass.
+ * get_unaligned()/put_unaligned() read and write the bytes in CPU order, so
+ * XORing with cpu_to_le32(word) matches the little-endian keystream bytes.
+ */
+void chacha_xor_generic(struct chacha_state *state, u8 *dst, const u8 *src,
+			unsigned int bytes, int nrounds)
+{
+	struct chacha_state x;
+	int i;
+
+	while (bytes >= CHACHA_BLOCK_SIZE) {
+		x = *state;
+		chacha_permute(&x, nrounds);
+		for (i = 0; i < ARRAY_SIZE(x.x); i++) {
+			u32 k = (__force u32)cpu_to_le32(x.x[i] + state->x[i]);
+
+			put_unaligned(get_unaligned((const u32 *)src + i) ^ k,
+				      (u32 *)dst + i);
+		}
+		state->x[12]++;
+		bytes -= CHACHA_BLOCK_SIZE;
+		dst += CHACHA_BLOCK_SIZE;
+		src += CHACHA_BLOCK_SIZE;
+	}
+	if (bytes) {
+		u8 stream[CHACHA_BLOCK_SIZE] __aligned(sizeof(long));
+
+		chacha_block_generic(state, stream, nrounds);
+		for (i = 0; i < bytes; i++)
+			dst[i] = src[i] ^ stream[i];
+		memzero_explicit(stream, sizeof(stream));
+	}
+	chacha_zeroize_state(&x);
+}
+EXPORT_SYMBOL(chacha_xor_generic);
+
